<?xml version="1.0" encoding="UTF-8"?> 

<targets> 
  <database> 
    <server>localhost</server> 
    <type>MYSQL</type> 
    <user>root</user> 
    <password>Model_10</password> 
    <dbName>LIM10PopSyn</dbName> 
  </database> 

  <!-- Specify the PUMS data table names from which PUMA incidence tables are generated, as well as the field name for a unique identifier and the PUMS weight field name --> 
  <pumsData> 
    <idField>hhid</idField> 
    <pumaFieldName>PUMA_2000</pumaFieldName> 
    <metaFieldName>REGION</metaFieldName> 
    <tazFieldName>TAZ</tazFieldName> 
    <mazFieldName>MAZ</mazFieldName> 
    <weightField>newWeight</weightField> 
    <hhTable>newHouseholdTable</hhTable> 
    <persTable>newPersonTable</persTable> 
    <pumsHhTable>newHouseholdTable</pumsHhTable> 
    <pumsHhIdField>hhid</pumsHhIdField> 
    <pumsPersTable>newPersonTable</pumsPersTable> 
    <tazPromotionField>np</tazPromotionField> 
    <tazPromotionFactor>2</tazPromotionFactor> 
    <maxExpansionFactor>100</maxExpansionFactor> 
    <synpopOutputHhTableName>synpop_hh</synpopOutputHhTableName> 
    <synpopOutputPersTableName>synpop_person</synpopOutputPersTableName> 
    <outputHhAttributes>serialno, np, hincp, bld, nwrkrs_esr, type, familytype, num_studs</outputHhAttributes> 
    <outputPersAttributes>sporder, agep, sex, wkhp, esr, schg, employed, schl, indus_code, majuniv, majdorm, othuniv, othdorm, campustaz, campEmpLiv</outputPersAttributes> 
  </pumsData> 

  <!-- Specify the table name and name of id field for the MAZ control totals table --> 
  <mazControlsTable> 
    <mazTable id="1"> 
      <table_name>control_totals_maz</table_name> 
      <id_field_name>MAZ</id_field_name> 
      <aggregation_level>MAZ</aggregation_level> 
    </mazTable> 
  </mazControlsTable> 

  <!-- Specify the table name and name of id field for the table of TAZ control totals that are not fields in the MAZ control total table --> 
  <tazControlsTable> 
    <tazTable id="1"> 
      <table_name>control_totals_taz</table_name> 
      <id_field_name>TAZ</id_field_name> 
      <aggregation_level>TAZ</aggregation_level> 
    </tazTable> 
  </tazControlsTable> 

  <!-- Specify the table name, id field name, and aggregation level for each table of META control totals --> 
  <metaControlsTables> 
    <metaTable id="1"> 
      <table_name>control_totals_meta</table_name> 
      <id_field_name>REGION</id_field_name> 
      <aggregation_level>PUMA_2000</aggregation_level> 
    </metaTable> 
  </metaControlsTables> 

  <target> 
    <!-- Total households + GQ University in each MAZ Control#0 --> 
    <marginals> 
      <id>0</id> 
      <description>MAZ Level Control: Total Number of Households + GQ</description> 
      <totalHouseholdsControl>true</totalHouseholdsControl> 
      <controlType>simple</controlType> 
      <geographyType>MAZ</geographyType> 
      <table>newHouseholdTable</table> 
      <constraint id="1"> 
        <importance>1.0E9</importance> 
        <controlField>tot_hh_gq</controlField> 
        <field>familyType</field> 
        <type>interval</type> 
        <lo_value>1</lo_value>   
        <lo_type>closed</lo_type> 
        <hi_value>3</hi_value> 
        <hi_type>closed</hi_type> 
      </constraint> 
    </marginals> 
  </target> 

    <target> 

        <!-- define conditions for total households control for households --> 
        <marginals> 
            <id>1</id> 
         <description>Number of Family and Non-Family Households Category</description> 
            <controlType>simple</controlType> 
            <geographyType>maz</geographyType> 
            <table>newHouseholdTable</table> 
            <constraint id="1"> 
             <importance>1.0E7</importance> 
             <controlField>tot_hh</controlField> 
             <field>familyType</field> 
             <type>interval</type> 
             <lo_value>1</lo_value> 
             <lo_type>closed</lo_type> 
             <hi_value>2</hi_value> 
             <hi_type>closed</hi_type> 
      </constraint> 
        </marginals> 

    </target> 

    <target> 

        <!-- define conditions for 1 MAZ level other students in dorms controls --> 
        <!-- this control set should be positioned after the total households and family/non-family households controls, 
             before the first set of other controls --> 
        <marginals> 
            <id>2</id> 
         <description>Number of major university Dorm Households Category</description> 
         <majorGroupQuartersIndicatorField>true</majorGroupQuartersIndicatorField> 
            <geographyType>maz</geographyType> 
            <controlType>count</controlType> 
            <table>newPersonTable</table> 
            <constraint id="1"> 
            <importance>1.0E7</importance>              
   <controlField>dorms</controlField> 
            <field>majDorm</field> 
            <type>equality</type> 
            <value>1</value> 
      </constraint> 
        </marginals> 

    </target> 


    <target> 
        <marginals> 
            <id>3</id> 
         <description>Number of other university Dorm Households Category</description> 
         <otherGroupQuartersIndicatorField>true</otherGroupQuartersIndicatorField> 
            <geographyType>maz</geographyType> 
            <controlType>count</controlType> 
            <table>newPersonTable</table> 
            <constraint id="1"> 
            <importance>1.0E7</importance>              
   <controlField>othdorms</controlField> 
            <field>othDorm</field> 
            <type>equality</type> 
            <value>1</value> 
      </constraint> 
        </marginals> 

    </target> 

  <target> 
  <!-- define conditions for total population control --> 
 <marginals> 
  <id>4</id> 
  <description>Residential Population</description> 
    <controlType>count</controlType> 
  <geographyType>maz</geographyType> 
  <table>newPersonTable</table> 
  <constraint id="1"> 
   <importance>1.0E5</importance> 
   <controlField>hhpop</controlField> 
   <field>hhagep</field> 
   <type>interval</type> 
   <lo_value>0</lo_value> 
   <lo_type>closed</lo_type> 
   <hi_value>infinity</hi_value> 
   <hi_type>open</hi_type> 
  </constraint> 
 </marginals> 
  </target> 

